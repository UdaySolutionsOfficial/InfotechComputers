---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { instituteData } from '../data/institute';
import { getWhatsAppUrl } from '../utils/whatsapp';

const whatsappUrl = getWhatsAppUrl({ type: 'general' });
---

<BaseLayout
  title="Page Not Found | Infotech Computers"
  description="The page you are looking for does not exist or has been moved. Explore our computer courses and digital services at Infotech Computers, Nidadavolu."
  noindex={true}
>
  <section class="py-20 sm:py-28 md:py-36 bg-gradient-to-b from-[#F3F7FC] via-white to-white flex items-center justify-center min-h-[70vh]">
    <Container size="default">
      <div class="max-w-2xl mx-auto text-center flex flex-col items-center">
        
        <!-- Large 404 badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[#EAF3FF] text-[#3478D4] border border-[#3478D4]/25 mb-6">
          <span>Error 404 &bull; Resource Not Found</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#183B63] tracking-tight font-['Manrope_Variable',sans-serif] leading-tight">
          Page Not Found
        </h1>

        <p class="mt-4 text-base sm:text-lg text-[#64748B] leading-relaxed max-w-lg">
          The page or course you are looking for might have been moved, renamed, or is temporarily unavailable.
        </p>

        <!-- Quick Navigation Cards -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-lg text-left">
          <a
            href="/"
            class="p-4 rounded-xl bg-white border border-[#E2EAF3] hover-elevate transition-all flex items-start gap-3 group"
          >
            <div class="w-9 h-9 rounded-lg bg-[#EAF3FF] text-[#183B63] group-hover:text-[#3478D4] flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div>
              <span class="block font-bold text-sm text-[#183B63] group-hover:text-[#3478D4] transition-colors">
                Return to Homepage
              </span>
              <span class="text-xs text-[#64748B]">Overview of our institute and offerings</span>
            </div>
          </a>

          <a
            href="/courses/"
            class="p-4 rounded-xl bg-white border border-[#E2EAF3] hover-elevate transition-all flex items-start gap-3 group"
          >
            <div class="w-9 h-9 rounded-lg bg-[#EAF7F2] text-[#299D72] flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                <polyline points="10 2 10 10 13 7 16 10 16 2"></polyline>
              </svg>
            </div>
            <div>
              <span class="block font-bold text-sm text-[#183B63] group-hover:text-[#299D72] transition-colors">
                Explore Courses
              </span>
              <span class="text-xs text-[#64748B]">View all 10 active and 2 upcoming courses</span>
            </div>
          </a>
        </div>

        <!-- Action CTAs -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <Button href="/" variant="primary" size="md">
            <span>Go to Homepage</span>
          </Button>

          <Button href={whatsappUrl} target="_blank" variant="outline" size="md">
            <span>Enquire on WhatsApp</span>
          </Button>
        </div>

        <p class="mt-8 text-xs text-[#64748B]">
          Need immediate assistance? Call us at <a href={`tel:${instituteData.contact.phone}`} class="text-[#3478D4] hover:underline font-semibold">{instituteData.contact.phoneFormatted}</a>
        </p>

      </div>
    </Container>
  </section>
</BaseLayout>
