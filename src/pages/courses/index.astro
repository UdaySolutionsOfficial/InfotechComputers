---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoursesHero from '../../components/courses/CoursesHero.astro';
import CourseInteractiveGrid from '../../components/courses/CourseInteractiveGrid.astro';
import ContactCTA from '../../components/shared/ContactCTA.astro';
import Container from '../../components/ui/Container.astro';
import { instituteData } from '../../data/institute';
---

<BaseLayout
  title="Computer Courses in Nidadavolu | Infotech Computers"
  description="Explore MS Office, Tally, Photoshop, CorelDRAW, C, C++, Java, Oracle and Python courses at Infotech Computers, Nidadavolu."
  canonicalPath="/courses/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Courses', path: '/courses/' },
  ]}
  preloadHeroImage="/images/generated/programming-learning-3d.jpg"
>
  <!-- Section 1: Courses Hero with 3D Visual & Breadcrumb -->
  <CoursesHero />

  <!-- Section 2, 3, 4, 5: Interactive Course Catalogue with Category Filters & Individual Enquiries -->
  <CourseInteractiveGrid />

  <!-- Section: Learning Guidance Notice -->
  <section class="py-10 bg-[#F3F7FC] border-y border-[#E2EAF3]">
    <Container size="default">
      <div class="rounded-xl p-6 sm:p-8 bg-white border border-[#E2EAF3] shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[#EAF3FF] text-[#3478D4] flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-[#183B63] font-['Manrope_Variable',sans-serif]">
              Practical Computer Knowledge &amp; Guidance
            </h3>
            <p class="text-xs sm:text-sm text-[#64748B] mt-1 leading-relaxed max-w-2xl">
              For information regarding course curriculum, admissions, and center timings, connect directly with N. Srinivas Sir or visit our center in Nidadavolu.
            </p>
          </div>
        </div>

        <a
          href={`tel:${instituteData.contact.phone}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#F3F7FC] hover:bg-[#EAF3FF] text-[#183B63] font-semibold text-xs sm:text-sm border border-[#E2EAF3] transition-colors whitespace-nowrap self-start md:self-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>Call: {instituteData.contact.phoneFormatted}</span>
        </a>
      </div>
    </Container>
  </section>

  <!-- Section 6: Course Enquiry CTA -->
  <ContactCTA
    title="Ready to Take the Next Step?"
    description="Connect with Infotech Computers and learn more about the courses that interest you. We are happy to answer any questions about lab timings and admissions."
    primaryButtonText="Enquire on WhatsApp"
    secondaryButtonText={`Call: ${instituteData.contact.phoneFormatted}`}
  />
</BaseLayout>
