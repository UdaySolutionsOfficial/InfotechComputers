---
import { getWhatsAppUrl } from '../../utils/whatsapp';
import { instituteData } from '../../data/institute';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';

const whatsappUrl = getWhatsAppUrl({ type: 'general' });
---

<aside aria-label="Quick WhatsApp Contact" class="fixed bottom-6 right-6 z-40 print:hidden">
  <div class="relative flex items-center group">
    <!-- Interactive hover tooltip badge (desktop) -->
    <div
      class="absolute right-full mr-3.5 hidden md:flex items-center gap-2 px-3.5 py-2 bg-[#183B63] text-white text-xs font-medium rounded-xl whitespace-nowrap shadow-xl pointer-events-none opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 border border-white/10"
      role="tooltip"
    >
      <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
      <span>Chat with Srinivas Sir on WhatsApp</span>
      <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 bg-[#183B63] rotate-45 border-t border-r border-white/10"></div>
    </div>

    <!-- Pulsing ambient ripple ring -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-40 animate-ping pointer-events-none scale-110"></span>
    <span class="absolute inset-0 rounded-full bg-[#25D366]/20 animate-pulse pointer-events-none scale-125"></span>

    <!-- Primary WhatsApp Floating Button -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Chat with ${instituteData.name} on WhatsApp`}
      class="relative flex items-center justify-center w-14 h-14 sm:w-15 sm:h-15 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white shadow-[0_8px_25px_rgba(37,211,102,0.45)] hover:shadow-[0_12px_32px_rgba(37,211,102,0.6)] transition-all duration-300 hover:scale-110 active:scale-95 focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
    >
      <!-- Official WhatsApp SVG Brand Icon -->
      <WhatsAppIcon size={30} class="text-white drop-shadow-sm transition-transform duration-300 group-hover:scale-105" />

      <!-- Active online green indicator badge -->
      <span class="absolute top-0 right-0 flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-80"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 border-2 border-white shadow-xs"></span>
      </span>
    </a>
  </div>
</aside>
