---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { instituteData } from '../../data/institute';
import { getWhatsAppUrl } from '../../utils/whatsapp';

export interface Props {
  title?: string;
  description?: string;
  badgeText?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
  isProjectEnquiry?: boolean;
  class?: string;
}

const {
  title = 'Ready to Upgrade Your Skills or Build Your Next Digital Product?',
  description = `Get in touch with Infotech Computers in Nidadavolu for expert computer education, or discuss software solutions delivered with our technical partner ${instituteData.collaboration.partnerName}.`,
  badgeText = 'Admissions & Consultations Open',
  primaryButtonText = 'Enquire on WhatsApp',
  primaryButtonHref,
  secondaryButtonText = `Call: ${instituteData.contact.phoneFormatted}`,
  secondaryButtonHref,
  isProjectEnquiry = false,
  class: className = '',
} = Astro.props;

const defaultWhatsappUrl = getWhatsAppUrl({ type: 'general' });
const defaultPhoneUrl = `tel:${instituteData.contact.phone}`;

const primaryHref = primaryButtonHref || defaultWhatsappUrl;
const secondaryHref = secondaryButtonHref || defaultPhoneUrl;
---

<section class={`py-14 sm:py-20 bg-[#F3F7FC] border-y border-[#E2EAF3] ${className}`}>
  <Container size="default">
    <div class="relative overflow-hidden bg-white rounded-2xl p-8 sm:p-12 lg:p-14 border border-[#E2EAF3] shadow-sm">
      <!-- Decorative background accent (strictly subtle, 15-20% blue) -->
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-[#EAF3FF] blur-3xl pointer-events-none" aria-hidden="true"></div>
      
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#EAF3FF] text-[#183B63] border border-[#3478D4]/20 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#299D72]"></span>
          <span>{badgeText}</span>
        </div>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#183B63] tracking-tight font-['Manrope_Variable',sans-serif]">
          {title}
        </h2>

        <p class="mt-4 text-base sm:text-lg text-[#64748B] leading-relaxed">
          {description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
          <Button href={primaryHref} target={primaryHref.startsWith('http') || primaryHref.startsWith('mailto:') ? '_blank' : undefined} variant="primary" size="lg">
            {isProjectEnquiry ? (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            )}
            <span>{primaryButtonText}</span>
          </Button>

          <Button href={secondaryHref} target={secondaryHref.startsWith('http') ? '_blank' : undefined} variant="outline" size="lg">
            <span>{secondaryButtonText}</span>
            {secondaryHref.startsWith('http') && (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            )}
          </Button>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-6 text-xs text-[#64748B] pt-4 border-t border-[#E2EAF3]">
          {isProjectEnquiry ? (
            <>
              <span class="inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#299D72]"></span>
                Technical Partner: {instituteData.collaboration.partnerName}
              </span>
              <span class="inline-flex items-center gap-1.5">
                Direct Email: {instituteData.collaboration.email}
              </span>
            </>
          ) : (
            <>
              <span class="inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {instituteData.location.formatted}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Hours: {instituteData.timings.operatingHours} (Mon–Sat)
              </span>
            </>
          )}
        </div>
      </div>
    </div>
  </Container>
</section>
