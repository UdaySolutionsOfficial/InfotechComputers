---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { instituteData } from '../../data/institute';
import { getUSolveProjectMailto } from '../../utils/whatsapp';
import { getInfotechMicroLogoUrl, getUSolveMicroLogoUrl } from '../../utils/assets';

const projectMailto = getUSolveProjectMailto('Website & Digital Solutions Consultation');
const infotechMicroLogoUrl = getInfotechMicroLogoUrl();
const usolveMicroLogoUrl = getUSolveMicroLogoUrl();
---

<section class="relative overflow-hidden py-12 sm:py-16 md:py-20 bg-gradient-to-b from-[#F3F7FC] to-white border-b border-[#E2EAF3]">
  <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-[#EAF3FF] blur-3xl pointer-events-none opacity-70" aria-hidden="true"></div>

  <Container size="default">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-xs text-[#64748B]">
        <li>
          <a href="/" class="hover:text-[#3478D4] transition-colors">Home</a>
        </li>
        <li aria-hidden="true" class="text-[#94A3B8]">&bull;</li>
        <li class="font-semibold text-[#183B63]" aria-current="page">Digital Services</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Narrative & Hero Copy -->
      <div class="lg:col-span-7">
        
        <!-- Distinct Eyebrow Badge with Transparent Micro-Logos & Positive Partnership Icon -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-white border border-[#E2EAF3] shadow-xs mb-4">
          <div class="flex items-center gap-1.5">
            <img
              src={infotechMicroLogoUrl}
              alt="Infotech Computers Logo"
              class="w-4 h-4 object-contain shrink-0"
              width="16"
              height="16"
              loading="lazy"
            />
            <span class="text-[#183B63] font-bold">INFOTECH COMPUTERS</span>
          </div>
          <span class="w-4 h-4 rounded-full bg-[#EAF3FF] text-[#3478D4] flex items-center justify-center shrink-0" title="Technical Partnership">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </span>
          <div class="flex items-center gap-1.5">
            <img
              src={usolveMicroLogoUrl}
              alt="USolve Logo"
              class="w-4 h-4 object-contain shrink-0"
              width="16"
              height="16"
              loading="lazy"
            />
            <span class="text-[#3478D4] font-bold">USOLVE</span>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[#183B63] tracking-tight font-['Manrope_Variable',sans-serif] leading-[1.16]">
          Turning Ideas Into <span class="text-[#3478D4]">Digital Solutions.</span>
        </h1>

        <p class="mt-4 text-base sm:text-lg text-[#64748B] max-w-2xl leading-relaxed">
          From professional websites to customized software and intelligent digital systems, we help individuals and businesses bring their ideas to life.
        </p>

        <p class="mt-2 text-xs sm:text-sm font-semibold text-[#183B63] italic">
          Digital services delivered in technical collaboration with <a href={instituteData.collaboration.websiteUrl} target="_blank" rel="noopener noreferrer" class="text-[#3478D4] hover:underline">USolve</a>.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
          <Button href={projectMailto} variant="primary" size="lg">
            <span>Discuss Your Project</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </Button>

          <Button href={instituteData.collaboration.websiteUrl} target="_blank" variant="outline" size="lg">
            <span>Visit USolve Website</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </Button>
        </div>
      </div>

      <!-- Right: 3D Innovation Visual Canvas -->
      <div class="lg:col-span-5">
        <div class="card-base p-3 bg-white border border-[#E2EAF3] shadow-md rounded-2xl overflow-hidden hover-elevate">
          <img
            src="/images/generated/digital-innovation-3d.jpg"
            alt="3D Digital Innovation & Software Systems Illustration"
            width="600"
            height="450"
            class="w-full h-auto rounded-xl object-cover"
            loading="eager"
          />
          <div class="mt-3 px-2 flex items-center justify-between text-xs text-[#64748B]">
            <span class="inline-flex items-center gap-1.5 font-medium text-[#183B63]">
              <span class="w-2 h-2 rounded-full bg-[#299D72]"></span>
              Production Ready Solutions
            </span>
            <span class="font-mono text-[11px] text-[#3478D4]">Web &bull; App &bull; Cloud</span>
          </div>
        </div>
      </div>

    </div>

  </Container>
</section>
