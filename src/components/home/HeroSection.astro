---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import GradientBlinds from '../ui/GradientBlinds';
import { instituteData } from '../../data/institute';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const whatsappUrl = getWhatsAppUrl({ type: 'general' });
---

<section id="home" class="relative overflow-hidden bg-white pt-6 pb-14 md:pt-14 md:pb-20 border-b border-[#E2EAF3] scroll-mt-20">
  <!-- Interactive GradientBlinds WebGL Background Animation (React Bits) - Calibrated for high readability -->
  <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden opacity-30 sm:opacity-45 z-0" aria-hidden="true">
    <GradientBlinds
      client:load
      gradientColors={["#6366F1", "#3478D4", "#38BDF8"]}
      angle={20}
      blindCount={16}
      blindMinWidth={60}
      spotlightRadius={0.5}
      shine={0.3}
      relief={0.35}
      glow={0.3}
      sway={0.35}
      hoverTilt={0.6}
      clickEffect="ripple"
      noise={0}
      gradientSpeed={1.5}
      distortAmount={12}
      lightMode={true}
      className="w-full h-full"
    />
  </div>

  <!-- Corporate White Gradient Mask: Guarantees 100% razor-sharp contrast & text legibility -->
  <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 pointer-events-none z-0" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-transparent to-white pointer-events-none z-0" aria-hidden="true"></div>

  <Container size="default" class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Copy & Actions (order-2 on mobile, lg:order-1 on desktop) -->
      <div class="order-2 lg:order-1 lg:col-span-7 flex flex-col items-start reveal-init">
        
        <!-- Eyebrow Tag with Live Beacon -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white/90 backdrop-blur-sm text-[#0D1F36] border border-[#3478D4]/30 mb-4 sm:mb-5 shadow-xs hover:border-[#3478D4]/60 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#299D72] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#299D72]"></span>
          </span>
          <span>ESTABLISHED 2010 &bull; 16+ YEARS OF EXPERIENCE</span>
        </div>

        <!-- Main Heading with High-Contrast Corporate Accent -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[50px] font-extrabold text-[#0D1F36] leading-[1.16] tracking-tight font-['Manrope_Variable',sans-serif]">
          Empowering Skills.<br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-[#183B63] via-[#3478D4] to-[#2563EB] bg-clip-text text-transparent">Shaping Futures.</span>
        </h1>

        <!-- Supporting Description: High Contrast Dark Slate for Total Readability -->
        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-[#0F243E] sm:text-[#183B63] leading-relaxed max-w-2xl font-semibold">
          Building computer knowledge and practical technology skills in Nidadavolu since 2010. At Infotech Computers, we help learners develop the confidence and skills to grow in a technology-driven world.
        </p>

        <!-- CTA Buttons with Micro-Interactions -->
        <div class="mt-7 sm:mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4 w-full sm:w-auto">
          <Button href="/courses/" variant="primary" size="lg" class="w-full sm:w-auto btn-shimmer group/btn">
            <span>Explore Our Courses</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover/btn:translate-x-1">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href={whatsappUrl} target="_blank" variant="outline" size="lg" class="w-full sm:w-auto hover:border-[#25D366] hover:text-[#183B63] group/wa transition-all duration-200">
            <WhatsAppIcon size={19} class="text-[#25D366] transition-transform duration-300 group-hover/wa:scale-115" />
            <span>Enquire on WhatsApp</span>
          </Button>
        </div>

        <!-- Interactive Trust Feature Badges -->
        <div class="mt-7 sm:mt-8 flex flex-wrap items-center gap-2 sm:gap-2.5">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[#F3F7FC] border border-[#E2EAF3] text-xs font-medium text-[#183B63] hover:border-[#3478D4]/40 hover:bg-[#EAF3FF] transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
            <span>Computer Education</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[#F3F7FC] border border-[#E2EAF3] text-xs font-medium text-[#183B63] hover:border-[#3478D4]/40 hover:bg-[#EAF3FF] transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>Programming</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[#F3F7FC] border border-[#E2EAF3] text-xs font-medium text-[#183B63] hover:border-[#3478D4]/40 hover:bg-[#EAF3FF] transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            <span>Digital Skills</span>
          </div>
        </div>
      </div>

      <!-- 3D Artwork Composition (order-1 on mobile, lg:order-2 on desktop) -->
      <div class="order-1 lg:order-2 lg:col-span-5 reveal-init delay-150 mb-2 lg:mb-0">
        <div class="relative group/hero-card">
          
          <!-- Ambient Glow Behind 3D Artwork -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-[#3478D4]/15 via-[#60A5FA]/12 to-[#299D72]/15 opacity-70 blur-xl group-hover/hero-card:opacity-100 transition-opacity duration-500 pointer-events-none -z-10"></div>

          <div class="relative rounded-2xl sm:rounded-3xl bg-gradient-to-b from-[#F3F7FC] via-white to-white p-3 sm:p-4 border border-[#E2EAF3] shadow-md hover-elevate transition-all duration-500">
            
            <!-- Top-Right Floating Badge: 16+ Years Experience -->
            <div class="absolute -top-2.5 -right-2 sm:-top-3 sm:-right-3 z-20 flex items-center gap-1.5 sm:gap-2 px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white/95 backdrop-blur-sm text-[#183B63] border border-[#E2EAF3] shadow-md animate-float">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-[#EAF3FF] text-[#3478D4] flex items-center justify-center font-bold text-xs">
                16+
              </div>
              <div class="flex flex-col">
                <span class="text-[11px] sm:text-xs font-bold font-['Manrope_Variable',sans-serif] text-[#183B63] leading-none">16+ Years</span>
                <span class="text-[9px] sm:text-[10px] text-[#64748B] mt-0.5">Experience</span>
              </div>
            </div>

            <!-- Main Image Canvas with Zoom on Hover -->
            <div class="overflow-hidden rounded-xl bg-[#F8FAFC]">
              <img
                src="/images/generated/hero-education-tech-3d.jpg"
                alt="3D Laptop and Educational Technology Illustration - Infotech Computers"
                width="800"
                height="600"
                class="w-full h-auto object-cover transform group-hover/hero-card:scale-[1.03] transition-transform duration-700 ease-out"
                loading="eager"
              />
            </div>

            <!-- Bottom Information Bar -->
            <div class="mt-3 px-2 flex items-center justify-between text-xs text-[#64748B]">
              <span class="inline-flex items-center gap-1.5 font-medium text-[#183B63]">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3478D4]">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {instituteData.location.formatted}
              </span>
              <span class="text-[11px] font-mono bg-[#EAF3FF] text-[#183B63] px-2 py-0.5 rounded border border-[#3478D4]/20 font-medium">
                Est. 2010
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>
