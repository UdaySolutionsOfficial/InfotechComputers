---

<div class="w-full max-w-full relative overflow-hidden py-3 marquee-container group select-none">
  <!-- Subtle ambient top/bottom border lines -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#E2EAF3] to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-[1px] bg-gradient-to-r from-transparent via-[#E2EAF3] to-transparent"></div>

  <!-- Fade masks on left and right for seamless entrance/exit -->
  <div class="marquee-fade-mask overflow-hidden w-full max-w-full">
    <div class="animate-marquee-track flex items-center gap-4 sm:gap-6 py-2">
      
      <!-- Primary Track (12 Course Logos) -->
      {coursesMarqueeData.map((course) => (
        <a
          href="/courses/"
          class="flex items-center gap-3.5 px-4 sm:px-5 py-2.5 rounded-2xl bg-white border border-[#E2EAF3] shadow-xs hover:border-[#3478D4]/50 hover:shadow-md hover:-translate-y-1 transition-all duration-300 shrink-0 select-none group/card"
          title={`Explore ${course.name} Course`}
        >
          <!-- Exact Authentic Unaltered Brand Logo -->
          <div class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 flex items-center justify-center transition-transform duration-300 group-hover/card:scale-110">
            <Fragment set:html={course.svg} />
          </div>

          <div class="flex flex-col text-left">
            <div class="flex items-center gap-2">
              <span class="text-sm sm:text-[15px] font-bold text-[#183B63] font-['Manrope_Variable',sans-serif] tracking-tight group-hover/card:text-[#3478D4] transition-colors whitespace-nowrap">
                {course.name}
              </span>
              {course.isUpcoming && (
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[#EAF3FF] text-[#3478D4] border border-[#3478D4]/20">
                  Upcoming
                </span>
              )}
            </div>
            <span class="text-[11px] font-medium text-[#64748B] whitespace-nowrap">
              {course.category}
            </span>
          </div>
        </a>
      ))}

      <!-- Duplicate Track (Seamless Loop with Mathematically Zero Stutter) -->
      {coursesMarqueeData.map((course) => (
        <a
          href="/courses/"
          aria-hidden="true"
          tabindex="-1"
          class="flex items-center gap-3.5 px-4 sm:px-5 py-2.5 rounded-2xl bg-white border border-[#E2EAF3] shadow-xs hover:border-[#3478D4]/50 hover:shadow-md hover:-translate-y-1 transition-all duration-300 shrink-0 select-none group/card"
        >
          <!-- Exact Authentic Unaltered Brand Logo -->
          <div class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 flex items-center justify-center transition-transform duration-300 group-hover/card:scale-110">
            <Fragment set:html={course.svg} />
          </div>

          <div class="flex flex-col text-left">
            <div class="flex items-center gap-2">
              <span class="text-sm sm:text-[15px] font-bold text-[#183B63] font-['Manrope_Variable',sans-serif] tracking-tight group-hover/card:text-[#3478D4] transition-colors whitespace-nowrap">
                {course.name}
              </span>
              {course.isUpcoming && (
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[#EAF3FF] text-[#3478D4] border border-[#3478D4]/20">
                  Upcoming
                </span>
              )}
            </div>
            <span class="text-[11px] font-medium text-[#64748B] whitespace-nowrap">
              {course.category}
            </span>
          </div>
        </a>
      ))}

    </div>
  </div>
</div>
