---
// Institute Video Card Component (Infotech Computers & USolve Collaboration)
// Clean, native, fully touchable YouTube embed for mobile, tablet, and desktop
---

<div class="rounded-2xl bg-[#F3F7FC] border border-[#E2EAF3] p-4 sm:p-6 shadow-sm transition-all duration-300 sm:hover:border-[#3478D4]/40" id="video-tour-container">
  
  <!-- Header Bar: Responsive Column on Mobile, Row on Tablet/Desktop -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3.5 sm:mb-4">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-10 h-10 rounded-xl bg-[#EAF3FF] text-[#3478D4] flex items-center justify-center shrink-0 shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path>
          <rect x="2" y="6" width="14" height="12" rx="2"></rect>
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="text-base sm:text-lg font-bold text-[#183B63] font-['Manrope_Variable',sans-serif] leading-tight truncate">
          Institute Video &amp; Center Update
        </h3>
        <p class="text-xs text-[#64748B] mt-0.5 truncate">
          In collaboration with USolve &bull; Nidadavolu
        </p>
      </div>
    </div>

    <a
      href="https://youtu.be/5crzF7AOVI0?si=OwY6sMYXpSZ-Wu6a"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 self-start sm:self-auto text-xs font-semibold text-[#3478D4] hover:text-[#183B63] hover:underline transition-colors shrink-0"
      title="Open video on YouTube"
    >
      <span>Watch on YouTube</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>

  <!-- Standard Responsive YouTube Video Container: Clean, zero-interception, 100% native touch across all devices -->
  <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-black border border-[#E2EAF3] shadow-md">
    <iframe
      src="https://www.youtube.com/embed/5crzF7AOVI0?playsinline=1&rel=0"
      title="Infotech Computer's Nidadavolu | New Update"
      class="w-full h-full absolute inset-0 border-0 rounded-xl"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>

</div>
