---
export interface Props {
  text: string;
  position?: 'top' | 'bottom';
  class?: string;
}

const {
  text,
  position = 'top',
  class: className = '',
} = Astro.props;

const positionClasses = {
  top: 'bottom-full left-1/2 -translate-x-1/2 mb-2',
  bottom: 'top-full left-1/2 -translate-x-1/2 mt-2',
};
---

<div class={`relative inline-flex group ${className}`}>
  <slot />
  <div
    role="tooltip"
    class={`absolute ${positionClasses[position]} hidden group-hover:flex group-focus-within:flex items-center px-2.5 py-1 text-xs font-medium text-white bg-[#183B63] rounded-md shadow-md whitespace-nowrap pointer-events-none z-50 animate-fade-in`}
  >
    {text}
  </div>
</div>
