---
// Official Full-Color Course Brand Logos for Infotech Computers
export interface Props {
  courseId: string;
  size?: number | string;
  class?: string;
}

const { courseId, size = '100%', class: className = '' } = Astro.props;

// Normalizing ID
const normalizedId = courseId.toLowerCase().replace(/_/g, '-');
