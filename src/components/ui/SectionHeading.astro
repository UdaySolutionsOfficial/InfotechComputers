---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  as: HeadingTag = 'h2',
  class: className = '',
} = Astro.props;

const alignmentClasses = {
  center: 'text-center mx-auto items-center',
  left: 'text-left items-start',
};

const descMaxWidth = align === 'center' ? 'max-w-2xl mx-auto' : 'max-w-2xl';
---

<div class={`flex flex-col mb-10 md:mb-14 ${alignmentClasses[align]} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-[#EAF3FF] text-[#183B63] border border-[#3478D4]/20 mb-3.5">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3478D4]"></span>
      <span>{eyebrow}</span>
    </div>
  )}

  <HeadingTag class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#183B63] font-['Manrope_Variable',sans-serif]">
    {title}
  </HeadingTag>

  {description && (
    <p class={`mt-3.5 text-base sm:text-lg text-[#64748B] leading-relaxed ${descMaxWidth}`}>
      {description}
    </p>
  )}
</div>
