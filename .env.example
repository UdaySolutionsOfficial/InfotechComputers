# ==============================================================================
# Infotech Computers Website — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      copy .env.example .env
# 2. When the final production domain is acquired and configured, set PUBLIC_SITE_URL.
# 3. Enable PUBLIC_INDEXING_ENABLED='true' ONLY when production domain is active.
# ==============================================================================

# Canonical production website URL (must start with https://, no trailing slash).
# Leave blank for local development, preview deployments, or staging environments.
# Example: PUBLIC_SITE_URL=https://infotechcomputersnidadavolu.com
PUBLIC_SITE_URL=

# Search engine indexing flag ('true' or 'false').
# When 'false' (default), all pages output 'noindex, nofollow' to prevent search engines
# from indexing development, preview, or unverified staging environments.
# Set to 'true' only in production after domain verification in Google Search Console.
PUBLIC_INDEXING_ENABLED=false
